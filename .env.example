# Node 24+. Never commit actual credentials.
PORT=3001
# Production HTTPS origin; leave blank for local development.
MEETINGOS_PUBLIC_URL=
# Production registration is disabled unless an internal invite code is set.
MEETINGOS_INVITE_CODE=
# Persistent directory; defaults to server/data. Existing legacy JSON is untouched.
AI_BOARD_DATA_DIR=

# Daily analysis and all persona perspectives: wei.run only. No LinkHarbor fallback.
WEI_LLM_BASE_URL=https://api.wei.run/v1
WEI_LLM_API_KEY=
LINKHARBOR_BASE_URL=https://api.linkharbor.ai/v1
LINKHARBOR_API_KEY=
# Set actual model IDs supported by your gateway; historical defaults are unverified.
MEETINGOS_GPT_MODEL=
MEETINGOS_CLAUDE_MODEL=
MEETINGOS_GEMINI_MODEL=gemini-3.7-flash
MEETINGOS_DEEPSEEK_MODEL=deepseek-v4-flash

ALIYUN_ASR_ENABLED=false
ALIYUN_ASR_API_KEY=
ALIYUN_ASR_MODEL=fun-asr-realtime
ALIYUN_ASR_REGION=cn-beijing
ALIYUN_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# Defaults to browser SpeechRecognition, which may use the browser vendor's service.
